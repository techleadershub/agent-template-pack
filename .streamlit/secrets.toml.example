# You do NOT need this file to get your first live link. The app runs in demo mode without it.
#
# To use a real AI model, paste the three lines below into your Streamlit app:
#   Streamlit Community Cloud -> your app -> Settings -> Secrets
# Never put a real key in a file on GitHub.

AI_API_KEY = "paste-your-key-here"

# Pick ONE provider and use its two lines (base url and model name):

# OpenAI
AI_BASE_URL = "https://api.openai.com/v1"
AI_MODEL = "gpt-4o-mini"

